# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Gemini (Google AI Studio). Copy the exact model IDs from AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=<3.5 Flash Lite model ID>
GEMINI_FALLBACK_MODEL=<3.1 Flash Lite model ID>

# Supabase (Project Settings > API, and Database > Connection string)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=   # Postgres connection string, used by Python and Power BI
